# Alamat backend karsajobs = <Node IP>:<Node Port> dari karsajobs-service (NodePort 30001).
# Minikube dijalankan dengan driver Docker di Windows, sehingga Node IP (192.168.49.2) tidak dapat
# diakses langsung dari browser. Karena itu NodePort dipublikasikan ke host dengan
#   minikube start --driver=docker --ports=30000:30000,30001:30001
# dan Node IP yang dapat diakses dari komputer ini adalah localhost.
VUE_APP_BACKEND=http://localhost:30001
